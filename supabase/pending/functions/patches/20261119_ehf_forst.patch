+// deno-lint-ignore no-explicit-any
+async function ehfFirstEnabled(admin: SupabaseClient<any, any, any>, legalEntityId: string): Promise<boolean> {
+  const { data, error } = await admin.from("invoice_reading_settings").select("ehf_first").eq("legal_entity_id", legalEntityId).maybeSingle();
+  return !error && (data as { ehf_first?: unknown } | null)?.ehf_first === true;
+}
