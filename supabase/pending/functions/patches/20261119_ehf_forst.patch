+/** Henter EHF-XML fra Tripletex-bilaget (bare GET). null = ingen EHF; feil gir aldri stopp, bare PDF-lesing. */
+async function fetchEhfXml(tt: string, ttId: string): Promise<{ xml: string; documentId: string } | null> {
+  const h = { Authorization: authHeader(tt), Accept: "application/json" };
+  const r = await fetch(`${baseUrl()}/v2/supplierInvoice/${ttId}?fields=voucher(id,ediDocument(id))`, { headers: h });
+  if (!r.ok) { await r.body?.cancel(); return null; }
+  const j = await r.json().catch(() => null);
+  const id = j?.value?.voucher?.ediDocument?.id;
+  if (id == null) return null;
+  const c = await fetch(`${baseUrl()}/v2/document/${id}/content`, { headers: { Authorization: authHeader(tt), Accept: "*/*" } });
+  if (!c.ok) { await c.body?.cancel(); return null; }
+  const len = Number(c.headers.get("content-length") ?? "");
+  if (Number.isFinite(len) && len > 15_000_000) { await c.body?.cancel(); return null; }
+  const text = await c.text();
+  return /<(\w+:)?(Invoice|CreditNote)[\s>]/.test(text) ? { xml: text, documentId: String(id) } : null;
+}
